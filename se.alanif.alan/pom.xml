<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>se.alanif</groupId>
    <artifactId>alanide-xtext-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>se.alanif.alan</artifactId>
  <packaging>jar</packaging>
  <name>Alan language (runtime)</name>

  <!--
    The Alan language runtime: grammar, generated ANTLR parser + EMF model, and
    the hand-written service classes (validation, scoping, formatting - Java).
    `mvn generate-sources` runs MWE2; `mvn compile` builds the generated code.
  -->

  <dependencies>
    <!-- Runtime API the generated parser/model + services compile against.
         The xtext-dev-bom manages MWE2/EMF versions but not these top-level
         org.eclipse.xtext.* artifacts, so pin them to ${xtext.version}. -->
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext</artifactId>
      <version>${xtext.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.xbase</artifactId>
      <version>${xtext.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.common.types</artifactId>
      <version>${xtext.version}</version>
    </dependency>

    <!-- Build-time only: the MWE2 generator + ANTLR3 tool. -->
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.mwe2.launch</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext.xtext.generator</artifactId>
      <version>${xtext.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>xtext-antlr-generator</artifactId>
      <version>[2.1.1,3)</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Grammar + hand-written sources live in src/ (Xtext convention). -->
    <sourceDirectory>src</sourceDirectory>
    <!-- The serialized grammar (Alan.xtextbin) and ANTLR .tokens generated into
         src-gen are loaded from the classpath at runtime, so copy the non-Java
         files from src/ and src-gen/ into the jar. -->
    <resources>
      <resource>
        <directory>src</directory>
        <excludes><exclude>**/*.java</exclude></excludes>
      </resource>
      <resource>
        <directory>src-gen</directory>
        <excludes><exclude>**/*.java</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <!-- Run MWE2 to generate parser/lexer/model + service stubs into src-gen/. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>mwe2</id>
            <phase>generate-sources</phase>
            <goals><goal>java</goal></goals>
          </execution>
        </executions>
        <configuration>
          <mainClass>org.eclipse.emf.mwe2.launch.runtime.Mwe2Launcher</mainClass>
          <!--
            exec:java runs in-process, so relative paths resolve against Maven's
            CWD (the reactor root), not the module. Use an absolute workflow path
            and override the workflow's rootPath so StandardProjectConfig still
            resolves baseName against THIS module.
          -->
          <arguments>
            <argument>${project.basedir}/src/se/alanif/alan/GenerateAlan.mwe2</argument>
            <argument>-p</argument>
            <argument>rootPath=${project.basedir}/..</argument>
          </arguments>
          <classpathScope>compile</classpathScope>
          <includePluginDependencies>false</includePluginDependencies>
          <!--
            After MWE2's main() returns, exec:java (default cleanupDaemonThreads=true)
            interrupts leftover threads. That hits EMF's daemon reference-clearing
            thread mid ReferenceQueue.remove() and prints a harmless (post-'Done.')
            InterruptedException. The thread is a daemon and dies with the JVM, so
            skip the cleanup to keep the build output clean.
          -->
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
      </plugin>

      <!-- Add the generated sources as a compile root. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-src-gen</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>src-gen</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
