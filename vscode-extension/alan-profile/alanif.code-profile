{
  "name": "Alan IF",
  "icon": "book",
  "settings": "{\"settings\":\"// Alan authoring profile -- a calmer, prose-friendly VS Code for writing adventures.\\n{\\n  // Open straight into your work, no \\\"Get Started\\\" tab.\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n\\n  // A document, not a codebase: strip the chrome a writer doesn't need.\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"breadcrumbs.enabled\\\": false,\\n  \\\"editor.renderWhitespace\\\": \\\"none\\\",\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"workbench.editor.enablePreview\\\": false,\\n\\n  // Keep the enclosing 'every X' / 'the Y' / 'verb Z' header in view while scrolling.\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n\\n  // Alan source is prose-heavy: wrap long description strings instead of scrolling.\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.lineHeight\\\": 1.6,\\n  \\\"editor.cursorBlinking\\\": \\\"solid\\\",\\n\\n  // Forgiving for non-programmers: save quietly, skip the scary prompts.\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n  \\\"files.autoSaveDelay\\\": 800,\\n\\n  // Guess the encoding when opening, instead of assuming UTF-8.\\n  //\\n  // Older Alan sources are ISO-8859-1. Opening one as UTF-8 turns every high byte\\n  // into U+FFFD, and with the auto-save above that corruption is written back to\\n  // disk about a second later, without a keystroke -- the original bytes are gone.\\n  //\\n  // Guessing does not have to be RIGHT to be safe, only single-byte: decoding and\\n  // re-encoding through any single-byte charset round-trips the file exactly, even\\n  // if it picks cp1252 for an ISO-8859-1 file. UTF-8 is the only candidate here that\\n  // can fail to decode, and it is the only one whose failure loses data.\\n  \\\"files.autoGuessEncoding\\\": true,\\n  \\\"security.workspace.trust.enabled\\\": false,\\n  \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n  \\\"update.showReleaseNotes\\\": false,\\n\\n  // Alan-specific editor behaviour: our language server supplies the completions,\\n  // so don't clutter them with random words from the buffer.\\n  \\\"[alanif]\\\": {\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\n    \\\"editor.suggest.showWords\\\": false\\n  }\\n}\\n\"}",
  "extensions": "[{\"identifier\":{\"id\":\"alanif.alan-if-ide\"},\"displayName\":\"Alan IF IDE\"}]"
}
