{
  "name": "Alan",
  "icon": "book",
  "settings": "{\"settings\":\"// Alan authoring profile -- a calmer, prose-friendly VS Code for writing adventures.\\n{\\n  // Open straight into your work, no \\\"Get Started\\\" tab.\\n  \\\"workbench.startupEditor\\\": \\\"none\\\",\\n\\n  // A document, not a codebase: strip the chrome a writer doesn't need.\\n  \\\"editor.minimap.enabled\\\": false,\\n  \\\"breadcrumbs.enabled\\\": false,\\n  \\\"editor.renderWhitespace\\\": \\\"none\\\",\\n  \\\"explorer.compactFolders\\\": false,\\n  \\\"workbench.editor.enablePreview\\\": false,\\n\\n  // Keep the enclosing 'every X' / 'the Y' / 'verb Z' header in view while scrolling.\\n  \\\"editor.stickyScroll.enabled\\\": true,\\n\\n  // Alan source is prose-heavy: wrap long description strings instead of scrolling.\\n  \\\"editor.wordWrap\\\": \\\"on\\\",\\n  \\\"editor.fontSize\\\": 14,\\n  \\\"editor.lineHeight\\\": 1.6,\\n  \\\"editor.cursorBlinking\\\": \\\"solid\\\",\\n\\n  // Forgiving for non-programmers: save quietly, skip the scary prompts.\\n  \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n  \\\"files.autoSaveDelay\\\": 800,\\n  \\\"security.workspace.trust.enabled\\\": false,\\n  \\\"telemetry.telemetryLevel\\\": \\\"off\\\",\\n  \\\"update.showReleaseNotes\\\": false,\\n\\n  // Alan-specific editor behaviour: our language server supplies the completions,\\n  // so don't clutter them with random words from the buffer.\\n  \\\"[alan]\\\": {\\n    \\\"editor.wordWrap\\\": \\\"on\\\",\\n    \\\"editor.suggest.showWords\\\": false\\n  }\\n}\\n\"}"
}
